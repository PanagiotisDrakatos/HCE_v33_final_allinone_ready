#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

last_msg="$(git log -1 --pretty=%B || true)"
if [[ "$last_msg" == *"[skip ci]"* ]]; then
  echo "[pre-push] Skipping due to [skip ci] in last commit."
  exit 0
fi

if [[ -f ".venv/bin/activate" ]]; then source ".venv/bin/activate"; fi

# Local feedback only. The remote required 'aggregate' check is the merge
# authority; a local skip never bypasses it. Blocks only on a failing gate.
python scripts/verify.py fast
python scripts/verify.py receipt

# Runtime proof is opt-in locally (needs the Docker Compose v2 plugin):
if [[ "${VERIFY_RUNTIME:-0}" == "1" ]]; then
  python scripts/verify.py runtime
  python scripts/verify.py receipt
fi

echo "[pre-push] verify fast + receipt passed ✅"
